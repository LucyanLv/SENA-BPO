MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 766b5dfeed8e222449a7a1a94562e6d7, type: 3}
  m_Name: BaseDatos
  m_EditorClassIdentifier: 
  questions:
  - question: "\xBFQu\xE9 significa el t\xE9rmino \"IVR\" en un call center?"
    answers:
    - "a) Interacci\xF3n Virtual R\xE1pida"
    - 'b) Indicador de Volumen de Respuestas '
    - c)  Informe de Ventas Relevantes
    - d)Respuesta Voz Interactiva
    correctAnswer: 0
  - question: "\xBFCu\xE1l de las siguientes opciones es una t\xE9cnica eficaz para
      manejar a un cliente enojado?"
    answers:
    - "a) Ignorar sus quejas y continuar con la soluci\xF3n."
    - "b) Mostrar empat\xEDa y escuchar activamente sus preocupaciones."
    - c) Decirle que no hay nada que puedas hacer para ayudar.
    - "d) Pedirle que env\xEDe un correo electr\xF3nico en lugar de hablar por tel\xE9fono."
    correctAnswer: 0
  - question: "En un contexto de call center, \xBFqu\xE9 significa el acr\xF3nimo
      \"SLA\"?"
    answers:
    - a) Servicio de Llamada Automatizada
    - "b) Seguridad y Liderazgo en Atenci\xF3n"
    - c) Acuerdo de Nivel de Servicio
    - "d) Soporte L\xF3gico Avanzado"
    correctAnswer: 0
  - question: "\xBFQu\xE9 debe hacer un agente de call center si no puede resolver
      el problema de un cliente de inmediato?"
    answers:
    - "a) Cerrar la llamada y dejar que el cliente lo resuelva por s\xED mismo."
    - b) Transferir la llamada a otro agente sin informar al cliente.
    - "c) Proporcionar una soluci\xF3n temporal y luego seguir investigando"
    - "d) Decir al cliente que llame de nuevo m\xE1s tarde."
    correctAnswer: 0
  - question: "\xBFCu\xE1l de las siguientes opciones es un ejemplo de un indicador
      clave de rendimiento (KPI) com\xFAnmente utilizado en un call center?"
    answers:
    - a) Temperatura de la sala de descanso
    - "b) Velocidad del viento en la ubicaci\xF3n del centro"
    - c) Tiempo promedio de espera en la fila
    - "d) Tama\xF1o de la pantalla del monitor"
    correctAnswer: 0
  - question: "\xBFQu\xE9 es el \"cross-selling\" en un contexto de call center?"
    answers:
    - a) Transferir llamadas entre diferentes departamentos.
    - b) Vender productos o servicios adicionales al cliente durante la llamada.
    - "c) Proporcionar informaci\xF3n sobre la pol\xEDtica de devoluciones."
    - "d) Resolver problemas t\xE9cnicos en los dispositivos del cliente."
    correctAnswer: 0
  - question: "\xBFCu\xE1l es el prop\xF3sito principal de un guion de llamadas en
      un call center?"
    answers:
    - "a) Limitar la conversaci\xF3n con el cliente."
    - "b) Asegurarse de que los agentes no se desv\xEDen del tema."
    - "c) Proporcionar una estructura para la conversaci\xF3n y ayudar al agente
      a guiar al cliente."
    - "d) Hacer que las llamadas sean m\xE1s largas para cumplir con los objetivos
      de tiempo."
    correctAnswer: 0
  - question: "\xBFQu\xE9 significa el t\xE9rmino \"tiempo de espera\" en un call
      center?"
    answers:
    - a) El tiempo que un agente pasa en pausa durante una llamada.
    - "b) El tiempo que un cliente est\xE1 dispuesto a esperar en la l\xEDnea."
    - c) El tiempo que un agente dedica a hablar con un cliente.
    - d) El tiempo que se necesita para resolver un problema del cliente.
    correctAnswer: 0
  - question: "\xBFCu\xE1l es el prop\xF3sito de un ACD en un call center?"
    answers:
    - a) Control de Acceso al Directorio
    - "b) Distribuci\xF3n Autom\xE1tica de Llamadas"
    - "c) Conexi\xF3n de Audio Directo"
    - "d) An\xE1lisis de Comunicaci\xF3n de Datos"
    correctAnswer: 0
  - question: "\xBFQu\xE9 es un \"CRM\" y c\xF3mo se utiliza en un call center?"
    answers:
    - "a) Control de Respuesta M\xFAltiple, utilizado para manejar m\xFAltiples llamadas
      simult\xE1neas."
    - "b) Comunicaci\xF3n y Registro de Mensajes, utilizado para enviar mensajes
      a los clientes."
    - "c) Gesti\xF3n de Relaciones con el Cliente, utilizado para mantener registros
      de interacciones y detalles de clientes."
    - "d) Central de Respuesta Moderna, utilizado para proporcionar respuestas autom\xE1ticas
      a los clientes."
    correctAnswer: 0
