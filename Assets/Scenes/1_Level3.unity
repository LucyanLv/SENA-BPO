--- !u!114 &565978543
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 565978542}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0490b10d256a1474b92b9a39d3bf97f3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questions:
  - questionText: "\xBFCu\xE1l es el rol de un supervisor en un centro de contacto?"
    answerOptions:
    - answerText: Realizar llamadas a clientes.
      isCorect: 0
      id: 1
    - answerText: "Gestionar la tecnolog\xEDa de la empresa."
      isCorect: 0
      id: 2
    - answerText: Coordinar las tareas de los agentes.
      isCorect: 1
      id: 3
    - answerText: Desarrollar estrategias de marketing.
      isCorect: 0
      id: 4
    level: 1
  - questionText: "\xBFQu\xE9 se entiende por ITO en el contexto de la tercerizaci\xF3n
      de procesos?"
    answerOptions:
    - answerText: "Tercerizaci\xF3n de procesos comerciales."
      isCorect: 0
      id: 1
    - answerText: "Tercerizaci\xF3n de procesos tecnol\xF3gicos."
      isCorect: 1
      id: 2
    - answerText: "Tercerizaci\xF3n de procesos de marketing."
      isCorect: 0
      id: 3
    - answerText: "Tercerizaci\xF3n de procesos de manufactura."
      isCorect: 0
      id: 4
    level: 1
  - questionText: "\xBFCu\xE1l de las siguientes opciones describe mejor una campa\xF1a
      en un Contact Center?"
    answerOptions:
    - answerText: "La ubicaci\xF3n f\xEDsica de un centro de contacto."
      isCorect: 0
      id: 1
    - answerText: "El horario de atenci\xF3n al cliente."
      isCorect: 0
      id: 2
    - answerText: "Un proyecto espec\xEDfico para el que se contrata un Contact Center."
      isCorect: 1
      id: 3
    - answerText: "El n\xFAmero total de agentes en un centro."
      isCorect: 0
      id: 4
    level: 1
  - questionText: "\xBFQu\xE9 implica la funci\xF3n de inbound en un Contact Center?"
    answerOptions:
    - answerText: Realizar llamadas salientes a clientes.
      isCorect: 0
      id: 1
    - answerText: ' Recibir llamadas de clientes.'
      isCorect: 1
      id: 3
    - answerText: "Gestionar la log\xEDstica interna del centro."
      isCorect: 0
      id: 2
    - answerText: "Coordinar el soporte t\xE9cnico de la empresa."
      isCorect: 0
      id: 4
    level: 1
  - questionText: "\xBFCu\xE1l es el prop\xF3sito principal de LOG OUT en el contexto
      de un centro de contacto?"
    answerOptions:
    - answerText: Ingresar al sistema.
      isCorect: 0
      id: 1
    - answerText: Realizar un seguimiento de llamadas.
      isCorect: 0
      id: 3
    - answerText: Procesar datos de clientes.
      isCorect: 0
      id: 2
    - answerText: "Desconectarse del sistema al finalizar la sesi\xF3n."
      isCorect: 1
      id: 4
    level: 1
  - questionText: "\xBFQu\xE9 significa BPO en la industria de tercerizaci\xF3n?"
    answerOptions:
    - answerText: "Tercerizaci\xF3n de procesos de tecnolog\xEDa."
      isCorect: 0
      id: 1
    - answerText: "Tercerizaci\xF3n de procesos comerciales."
      isCorect: 1
      id: 2
    - answerText: "Tercerizaci\xF3n de procesos creativos."
      isCorect: 0
      id: 3
    - answerText: "Tercerizaci\xF3n de procesos de fabricaci\xF3n."
      isCorect: 0
      id: 4
    level: 1
  - questionText: "\xBFCu\xE1l es el papel de un agente en un centro de contacto?"
    answerOptions:
    - answerText: Coordinar las tareas de los supervisores.
      isCorect: 0
      id: 1
    - answerText: "Gestionar la infraestructura tecnol\xF3gica."
      isCorect: 0
      id: 3
    - answerText: Realizar ventas en campo.
      isCorect: 0
      id: 2
    - answerText: Gestionar el contacto con los clientes.
      isCorect: 1
      id: 4
    level: 1
  - questionText: "\xBFCu\xE1l de las siguientes opciones describe el KPO?"
    answerOptions:
    - answerText: "Tercerizaci\xF3n de procesos de tecnolog\xEDa avanzada."
      isCorect: 0
      id: 1
    - answerText: "Tercerizaci\xF3n de procesos de conocimiento especializado."
      isCorect: 1
      id: 4
    - answerText: "Tercerizaci\xF3n de procesos de manufactura."
      isCorect: 0
      id: 2
    - answerText: "Tercerizaci\xF3n de procesos de atenci\xF3n al cliente."
      isCorect: 0
      id: 3
    level: 1
  - questionText: "\xBFQu\xE9 implica la funci\xF3n de OUTBOUND en un centro de contacto?"
    answerOptions:
    - answerText: Recibir llamadas de clientes.
      isCorect: 0
      id: 3
    - answerText: Realizar llamadas a clientes.
      isCorect: 1
      id: 1
    - answerText: "Gestionar la infraestructura tecnol\xF3gica."
      isCorect: 0
      id: 2
    - answerText: "Coordinar la log\xEDstica interna del centro."
      isCorect: 0
      id: 4
    level: 1
  - questionText: "\xBFCu\xE1l es el prop\xF3sito del LOG IN en el contexto de un
      centro de contacto?"
    answerOptions:
    - answerText: ' Registrar las ventas realizadas.'
      isCorect: 0
      id: 1
    - answerText: " Iniciar una campa\xF1a de marketing."
      isCorect: 0
      id: 3
    - answerText: " Ingresar al sistema con usuario y contrase\xF1a."
      isCorect: 1
      id: 4
    - answerText: " Desconectarse del sistema al final del d\xEDa."
      isCorect: 0
      id: 2
    level: 1
